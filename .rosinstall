# ROS 1 dependencies not available from the Alpine ROS package repository.
#
# mcl_3dl_msgs is released, but only in its pre-hybrid form, which does not
# emit the ROS 2-style headers this package includes; sq_ros1_rclcpp_compat is
# not released at all. Both are therefore built from source here.
#
# The ROS 2 job uses ros2.rosinstall instead: sq_ros1_rclcpp_compat is guarded
# by $ROS_VERSION == 1 and must not be checked out for it.
- git:
    local-name: sq_ros1_rclcpp_compat
    uri: https://github.com/seqsense/sq_ros1_rclcpp_compat.git
    version: main
- git:
    local-name: mcl_3dl_msgs
    uri: https://github.com/seqsense/mcl_3dl_msgs.git
    version: master
