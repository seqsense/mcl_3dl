# Source dependency not available from the Alpine ROS package repository,
# shared by the ROS 1 and ROS 2 CI jobs.
#
# mcl_3dl_msgs is released, but only in its pre-hybrid form, which does not
# emit the ROS 2-style headers this package includes. It is therefore built
# from source here.
- git:
    local-name: mcl_3dl_msgs
    uri: https://github.com/seqsense/mcl_3dl_msgs.git
    version: master
